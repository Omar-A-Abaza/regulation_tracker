# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# .env is on git's ignore list, so your keys never get uploaded.

# --- AI summaries (Claude Sonnet 5.5) ---
# Your Anthropic API key, from console.anthropic.com
ANTHROPIC_API_KEY=
# Most a single `summarize` run may spend, in US dollars
SUMMARY_BUDGET_USD=1.50

# --- Update email (Gmail) ---
# The Gmail address that sends the email
SMTP_USER=
# A Gmail "app password" (16 letters), not your normal password.
# Make one at https://myaccount.google.com/apppasswords (needs 2-step verification on).
SMTP_PASSWORD=
# Who gets the email. Separate several addresses with commas.
ALERT_TO=

# --- Database ---
# Leave this commented out to use the default: data/tracker.db in this project.
# DATABASE_URL=sqlite:////full/path/to/tracker.db
